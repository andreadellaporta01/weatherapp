# === Build outputs ===
.gradle/
build/
out/
.kotlin/
DerivedData/

# Keep important Gradle files
!gradle/wrapper/gradle-wrapper.jar
!**/build.gradle.kts
!**/settings.gradle.kts

# === IDE: IntelliJ / Android Studio ===
.idea/
.idea_modules/
*.iml
*.iws
*.ipr
*.hprof

# === IDE: Xcode ===
# Per-user state — ignore everywhere
**/xcuserdata/
**/*.xcuserstate
**/*.xcuserdatad
*.xcscheme
# NOTE: do NOT ignore *.xcworkspace — iosApp/iosApp.xcworkspace must stay tracked

# === IDE: VS Code ===
.vscode/

# === iOS ===
Pods/
.swiftpm/
.build/
*.ipa
*.xcarchive

# === Android packaging ===
*.apk
*.aab
*.ap_
*.jks
*.keystore

# === Compose Desktop distributables ===
# (already inside build/, but defensive in case artifacts are copied out)
*.dmg
*.exe
*.msi
*.pkg
*.deb
*.snap
*.rpm

# === Logs / OS / runtime junk ===
*.log
*.hprof
logs/
.DS_Store
Thumbs.db
npm-debug.log

# === Secrets / local config ===
.env
.env.local
.env.*.local
local.properties
secrets.properties
composeApp/local.properties
composeApp/secrets.properties
composeApp/preferences.properties
*.p12
*.pem
*.cer
*.gpg

# === Fastlane ===
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/test_output/
**/fastlane/screenshots/
**/fastlane/README.md
**/fastlane/.env
**/fastlane/.env.*
**/fastlane/.secrets
**/fastlane/.keys
**/fastlane/metadata/**/*.txt
**/fastlane/metadata/**/*.md
**/fastlane/metadata/**/*.xml
**/fastlane/metadata/**/*.json

# === Web / Yarn (used by wasmJs target) ===
node_modules/
.yarn/
.yarnrc.yml
